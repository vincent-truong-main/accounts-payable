<h1>AP aging report</h1>
<p>As of <%= l(@aging_report.as_of) %></p>

<table>
  <thead>
    <tr>
      <th>Vendor</th>
      <th class="num">Current</th>
      <th class="num">1–30 days</th>
      <th class="num">31–60 days</th>
      <th class="num">61–90 days</th>
      <th class="num">90+ days</th>
      <th class="num">Total</th>
    </tr>
  </thead>
  <tbody>
    <% @aging_report.vendor_rows.each do |row| %>
      <tr>
        <td><%= row.vendor.name %></td>
        <% AgingReport::BUCKETS.each do |bucket| %>
          <td class="num"><%= money(row.outstanding_balance_by_bucket[bucket]) %></td>
        <% end %>
        <td class="num"><%= money(row.total_cents) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
