<h1><%= @vendor.name %></h1>
<div class="card">
  <dl>
    <dt>Email</dt><dd><%= @vendor.email %></dd>
    <dt>Terms</dt><dd>Net <%= @vendor.payment_terms_days %></dd>
    <dt>Outstanding</dt><dd><%= money(@vendor.outstanding_balance_cents) %></dd>
  </dl>
</div>

<h2>Invoices</h2>
<table>
  <thead><tr><th>Number</th><th>Status</th><th>Issued</th><th>Due</th><th class="num">Total</th><th class="num">Balance</th></tr></thead>
  <tbody>
    <% @invoices.each do |invoice| %>
      <tr>
        <td><%= link_to invoice.number, invoice %></td>
        <td><%= status_badge(invoice.status) %></td>
        <td><%= l(invoice.issued_on) %></td>
        <td><%= invoice.due_on ? l(invoice.due_on) : "—" %></td>
        <td class="num"><%= money(invoice.total_cents) %></td>
        <td class="num"><%= money(invoice.balance_due_cents) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
